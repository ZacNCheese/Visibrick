@page "/catalog/{Slug}"
@implements IDisposable
@inject CatalogService Catalog
@inject CollectionService Collection
@inject AuthService Auth
@inject NavigationManager Navigation
@inject PageMemory Memory
@inject IJSRuntime JS

@* One catalog type (/catalog/sets etc.): search, a grid of items, and "Load more". The search is kept in the
   address (?q=batman) so it survives a refresh and can be shared. *@

<PageTitle>@(_type?.Name ?? "Catalog") · Visibrick</PageTitle>

@if (_type is null)
{
    <div class="page narrow">
        <h1>Not found</h1>
        <p class="muted">There's no catalog called "@Slug". <a href="catalog">See the whole catalog</a>.</p>
    </div>
}
else
{
    <div class="page">
        <div class="page-header">
            <a class="link-btn back" href="catalog">‹ Catalog</a>
            <h1>@_type.Name</h1>
            <p class="muted">@SummaryText</p>
        </div>

        <div class="toolbar">
            @if (_tops.Count > 0)
            {
                @* Categories, biggest first (the selected one is moved to the front so it's always in view) *@
                <nav class="chip-scroll" aria-label="Categories">
                    <a class="chip-btn @(Cat is null ? "selected" : "")" href="@CategoryUri(null, null)">All</a>
                    @foreach (var category in _tops.OrderByDescending(c => c.Top == Cat))
                    {
                        <a class="chip-btn @(category.Top == Cat ? "selected" : "")" href="@CategoryUri(category.Top, null)">
                            @category.Top <span class="chip-count">@category.ItemCount.ToString("N0")</span>
                        </a>
                    }
                </nav>

                @if (Cat is not null && _subs.Count > 0)
                {
                    <nav class="chip-scroll sub" aria-label="@Cat categories">
                        <a class="chip-btn @(Sub is null ? "selected" : "")" href="@CategoryUri(Cat, null)">All @Cat</a>
                        @foreach (var category in _subs.OrderByDescending(c => c.Sub == Sub))
                        {
                            <a class="chip-btn @(category.Sub == Sub ? "selected" : "")" href="@CategoryUri(Cat, category.Sub)">
                                @category.Sub <span class="chip-count">@category.ItemCount.ToString("N0")</span>
                            </a>
                        }
                    </nav>
                }
            }

            <div class="input">
                <input type="search" placeholder="Search by name or number" aria-label="Search @_type.Name"
                       value="@Q" @oninput="OnSearchInput" />
            </div>
        </div>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        else if (_items.Count == 0 && !_loading)
        {
            <div class="clay-card center stack">
                <h2>@(IsFiltered ? "No matches" : $"No {_type.CountNoun} yet")</h2>
                <p class="muted">
                    @(!IsFiltered
                        ? "They'll appear once the catalog has been imported."
                        : string.IsNullOrWhiteSpace(Q)
                            ? "Nothing in this category yet."
                            : $"Nothing {(Cat is null ? "" : $"in {Sub ?? Cat} ")}matches \"{Q}\". Try a different name or number.")
                </p>
            </div>
        }

        <div class="card-grid">
            @foreach (var item in _items)
            {
                <ItemCard @key="item.Key" Item="item" />
            }
        </div>

        <div class="load-more">
            @if (_loading)
            {
                <span class="spinner" aria-label="Loading"></span>
            }
            else if (_items.Count < _total)
            {
                <button class="btn btn-primary" @onclick="LoadMoreAsync">Load more</button>
            }
        </div>
    </div>
}

@code {
    private const int PageSize = 60;

    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery] public string? Q { get; set; }

    // Category filter, e.g. ?cat=Super%20Heroes&sub=Avengers (sets and minifigs)
    [SupplyParameterFromQuery] public string? Cat { get; set; }
    [SupplyParameterFromQuery] public string? Sub { get; set; }

    private CatalogType? _type;
    private List<CatalogService.Category> _tops = [];
    private List<CatalogService.Category> _subs = [];
    private string? _categoriesFor;
    private readonly List<CatalogItem> _items = [];
    private int _total;
    private bool _loading;
    private string? _error;
    private string? _loadedFor;
    private string? _memoryKey;
    private double? _restoreScroll;
    private IDisposable? _leaving;
    private int _generation;
    private CancellationTokenSource? _searchDelay;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(Q) || Cat is not null;

    private string SummaryText => _loading && _items.Count == 0
        ? ""
        : $"{_total:N0} {(string.IsNullOrWhiteSpace(Q) ? "" : "matching ")}{_type!.CountNoun}{(Cat is null ? "" : $" in {Sub ?? Cat}")}";

    // Sets and minifigs have categories worth filtering by (themes, licenses like Marvel or Disney)
    private bool HasCategories => _type == CatalogType.Sets || _type == CatalogType.Minifigs;

    // The same page with a different category (keeping the search)
    private string CategoryUri(string? top, string? sub)
        => Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["cat"] = top, ["sub"] = sub });

    protected override void OnInitialized()
    {
        Collection.Changed += OnCollectionChanged;
        _ = Collection.EnsureLoadedAsync();

        // Leaving this list (to an item, another category...): remember what was loaded and the scroll position
        _leaving = Navigation.RegisterLocationChangingHandler(async _ =>
        {
            if (_memoryKey is not null && _items.Count > 0)
                Memory.Save(_memoryKey, new PageMemory.Snapshot([.. _items], _total, await JS.InvokeAsync<double>("visibrick.scrollY")));
        });
    }

    // Runs on first visit and whenever the address changes (another type, or a new search)
    protected override async Task OnParametersSetAsync()
    {
        _type = CatalogRoutes.FromSlug(Slug);
        var key = $"{Slug}|{Q}|{Cat}|{Sub}";
        if (_type is null || key == _loadedFor)
            return;

        _loadedFor = key;
        _memoryKey = Navigation.Uri;
        _items.Clear();
        _total = 0;

        // Back to a list seen before: show what it had loaded and return to where it was scrolled
        if (Memory.Get(_memoryKey) is { } saved)
        {
            _items.AddRange(saved.Items);
            _total = saved.Total;
            _restoreScroll = saved.ScrollY;
            await LoadCategoriesAsync();
            return;
        }

        await Task.WhenAll(LoadMoreAsync(), LoadCategoriesAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreScroll is { } y && _items.Count > 0)
        {
            _restoreScroll = null;
            await JS.InvokeVoidAsync("scrollTo", 0, y);
        }
    }

    // The chip rows. If they can't load, the page still works without them.
    private async Task LoadCategoriesAsync()
    {
        var key = $"{Slug}|{Cat}";
        if (key == _categoriesFor)
            return;

        _categoriesFor = key;
        if (!HasCategories)
        {
            _tops = [];
            _subs = [];
            return;
        }

        try
        {
            var tops = Catalog.GetCategoriesAsync(_type!);
            var subs = Cat is null ? Task.FromResult(new List<CatalogService.Category>()) : Catalog.GetCategoriesAsync(_type!, Cat);
            _tops = await tops;
            _subs = await subs;
        }
        catch (AppException ex)
        {
            Console.WriteLine("Loading categories failed: " + ex.Message);
        }
    }

    private async Task LoadMoreAsync()
    {
        var generation = ++_generation;
        _loading = true;
        _error = null;

        try
        {
            var (rows, total) = await Catalog.SearchAsync(_type!, Q, _items.Count, PageSize, Cat, Sub);

            // A newer search started while this page was loading
            if (generation != _generation)
                return;

            _items.AddRange(rows);
            _total = total;
        }
        catch (AppException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (generation == _generation)
                _loading = false;
        }
    }

    // Wait until typing pauses, then put the search in the address (which reloads the list)
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchDelay?.Cancel();
        _searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchDelay.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        var text = e.Value?.ToString()?.Trim();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("q", string.IsNullOrEmpty(text) ? null : text), replace: true);
    }

    private void OnCollectionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Collection.Changed -= OnCollectionChanged;
        _leaving?.Dispose();
    }
}
