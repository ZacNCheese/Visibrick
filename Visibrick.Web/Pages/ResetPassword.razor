@page "/account/reset-password"
@inject AuthService Auth
@inject NavigationManager Navigation

@* Opened from a "reset your password" email (via /auth/callback, which signs the user in first) *@

<PageTitle>Choose a new password · Visibrick</PageTitle>

<div class="page form">
    <div class="page-header">
        <h1>Choose a new password</h1>
        <p class="muted">@(Auth.IsSignedIn ? $"For {Auth.CurrentUser?.Email}" : "This link has expired. Request a new one from the sign-in page.")</p>
    </div>

    @if (Auth.IsSignedIn)
    {
        <form class="stack" style="gap: 20px" @onsubmit="SaveAsync">
            <div class="field">
                <label for="password">New password</label>
                <div class="input">
                    <input id="password" type="@(_show ? "text" : "password")" autocomplete="new-password" required
                           minlength="8" @bind="_password" />
                    <button type="button" class="link-btn" @onclick="() => _show = !_show">@(_show ? "Hide" : "Show")</button>
                </div>
                <p class="caption">At least 8 characters.</p>
            </div>

            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }

            <button type="submit" class="btn btn-primary" disabled="@_busy">Save new password</button>
        </form>
    }
    else
    {
        <a class="btn btn-primary" href="signin">Go to sign in</a>
    }
</div>

@code {
    private string _password = "";
    private bool _show;
    private bool _busy;
    private string? _error;

    protected override Task OnInitializedAsync() => Auth.InitializeAsync();

    private async Task SaveAsync()
    {
        if (_password.Length < 8)
        {
            _error = "Use at least 8 characters.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Auth.ChangePasswordAsync(_password);
            Navigation.NavigateTo("collection");
        }
        catch (AppException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
