@page "/"
@page "/collection"
@implements IDisposable
@inject AuthService Auth
@inject CollectionService Collection
@inject ProfileService Profile
@inject NavigationManager Navigation
@inject PageMemory Memory
@inject IJSRuntime JS

<PageTitle>My Collection · Visibrick</PageTitle>

<div class="page">
    <div class="page-header">
        <h1>My Collection</h1>
        <p class="muted">@SubtitleText</p>
    </div>

    @if (!Auth.IsSignedIn)
    {
        <div style="max-width: 640px; margin: 0 auto">
            <SignInCard />
        </div>
    }
    else if (_counts.Count == 0 && !_loading)
    {
        <div class="clay-card center stack" style="max-width: 640px; margin: 0 auto">
            <img class="brand-mark" src="images/brand_mark.svg" alt="" />
            <h2>Your collection is empty</h2>
            <p class="muted">Find minifigs, sets, parts and more in the catalog, and tap + to add them here.</p>
            <a class="btn btn-primary" href="catalog">Browse the catalog</a>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="row" style="gap: 8px">
                <button class="chip-btn @(_filter is null && _only == CollectionFilter.None ? "selected" : "")" @onclick="() => FilterAsync(null)">All · @_counts.Values.Sum(c => c.Items).ToString("N0")</button>
                @foreach (var type in CatalogType.All.Where(t => _counts.ContainsKey(t.Code)))
                {
                    <button class="chip-btn @(_filter == type.Code && _only == CollectionFilter.None ? "selected" : "")" @onclick="() => FilterAsync(type.Code)">@type.Name · @_counts[type.Code].Items.ToString("N0")</button>
                }
                @if (Collection.ItemsWithNew > 0)
                {
                    <button class="chip-btn @(_only == CollectionFilter.New ? "selected" : "")" @onclick="() => ShowOnlyAsync(CollectionFilter.New)">New · @Collection.ItemsWithNew</button>
                }
                @if (Collection.ItemsWithNew > 0 && Collection.ItemsWithUsed > 0)
                {
                    <button class="chip-btn @(_only == CollectionFilter.Used ? "selected" : "")" @onclick="() => ShowOnlyAsync(CollectionFilter.Used)">Used · @Collection.ItemsWithUsed</button>
                }
                @if (Collection.ItemsWithMissing > 0)
                {
                    <button class="chip-btn missing @(_only == CollectionFilter.Missing ? "selected" : "")" @onclick="() => ShowOnlyAsync(CollectionFilter.Missing)">Missing pieces · @Collection.ItemsWithMissing</button>
                }
            </div>
            <div class="input">
                <input type="search" placeholder="Search your collection" aria-label="Search your collection" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        else if (_items.Count == 0 && !_loading)
        {
            <div class="clay-card center stack">
                <h2>Nothing matches</h2>
                <p class="muted">Try a different search or filter.</p>
            </div>
        }

        <div class="card-grid">
            @foreach (var item in _items)
            {
                <ItemCard @key="item.Key" Item="item" Note="@ConditionNote(item)" />
            }
        </div>

        <div class="load-more">
            @if (_loading)
            {
                <span class="spinner" aria-label="Loading"></span>
            }
            else if (_items.Count < _total)
            {
                <button class="btn btn-primary" @onclick="() => LoadMoreAsync()">Load more</button>
            }
        </div>
    }
</div>

@code {
    private const int PageSize = 60;

    private Dictionary<string, (int Items, int Pieces)> _counts = [];
    private readonly List<CatalogItem> _items = [];
    private int _total;
    private bool _loading = true;
    private string? _error;
    private string? _filter;
    private CollectionFilter _only;

    // Remembering this page for Back (see PageMemory)
    private const string MemoryKey = "collection";
    private IDisposable? _leaving;
    private double? _restoreScroll;
    private int _loadedVersion;

    // "New", "Used" or "1 new · 2 used" for sets and minifigs (in place of the year)
    private string? ConditionNote(CatalogItem item)
    {
        if (!CollectionService.HasCondition(item.Type))
            return null;

        var fresh = Collection.NewQuantityOf(item.Type, item.Number);
        var used = Collection.UsedQuantityOf(item.Type, item.Number);
        return (fresh, used) switch
        {
            (0, _) => "Used",
            (_, 0) => "New",
            _ => $"{fresh} new · {used} used"
        };
    }
    private string? _search;
    private int _generation;
    private CancellationTokenSource? _searchDelay;

    private string SubtitleText
    {
        get
        {
            if (!Auth.IsSignedIn)
                return "Everything you own, down to the last brick.";

            var pieces = _counts.Values.Sum(c => c.Pieces);
            var different = _counts.Values.Sum(c => c.Items);
            return different == 0
                ? $"Signed in as {Profile.DisplayName}"
                : $"{pieces:N0} item{(pieces == 1 ? "" : "s")} · {different:N0} different";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnChanged;
        Collection.Changed += OnChanged;
        Profile.Changed += OnRefresh;

        // Leaving (e.g. to open an item): remember the filters, what was loaded and the scroll position
        _leaving = Navigation.RegisterLocationChangingHandler(async _ =>
        {
            if (Auth.IsSignedIn && _items.Count > 0)
                Memory.Save(MemoryKey, new PageMemory.Snapshot([.. _items], _total, await JS.InvokeAsync<double>("visibrick.scrollY"),
                    _loadedVersion, _filter, _only, _search));
        });

        await Auth.InitializeAsync();

        // Back from an item: pick up where you were
        if (Auth.IsSignedIn && Memory.Get(MemoryKey) is { } saved)
        {
            await Collection.EnsureLoadedAsync();
            _counts = Collection.CountsByType();
            (_filter, _only, _search) = (saved.Filter, saved.Only, saved.Search);
            _restoreScroll = saved.ScrollY;

            if (saved.Version == Collection.Version)
            {
                _items.AddRange(saved.Items);
                _total = saved.Total;
                _loadedVersion = saved.Version;
                _loading = false;
            }
            else
            {
                // Something changed while you were away (e.g. you removed that item): reload as much as was showing
                await LoadMoreAsync(Math.Max(PageSize, saved.Items.Count));
            }
            return;
        }

        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreScroll is { } y && _items.Count > 0 && !_loading)
        {
            _restoreScroll = null;
            await JS.InvokeVoidAsync("scrollTo", 0, y);
        }
    }

    // Signed in/out, or the collection changed (e.g. something was removed on its item page)
    private void OnChanged() => InvokeAsync(ReloadAsync);

    private void OnRefresh() => InvokeAsync(StateHasChanged);

    private async Task ReloadAsync()
    {
        _items.Clear();
        _total = 0;

        if (!Auth.IsSignedIn)
        {
            _counts = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        await Collection.EnsureLoadedAsync();
        _counts = Collection.CountsByType();

        // The filtered type no longer has anything in it
        if (_filter is not null && !_counts.ContainsKey(_filter))
            _filter = null;

        // The extra filter no longer has anything in it (e.g. the last missing piece was found)
        var left = _only switch
        {
            CollectionFilter.Missing => Collection.ItemsWithMissing,
            CollectionFilter.New => Collection.ItemsWithNew,
            CollectionFilter.Used => Collection.ItemsWithUsed,
            _ => 1
        };
        if (left == 0)
            _only = CollectionFilter.None;

        await LoadMoreAsync();
    }

    // take: how many to load (more than a page when putting back a list that had been scrolled further)
    private async Task LoadMoreAsync(int take = PageSize)
    {
        var generation = ++_generation;
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var version = Collection.Version;
            var (rows, total) = await Collection.SearchAsync(_only == CollectionFilter.None ? _filter : null, _search, _items.Count, take, _only);
            if (generation != _generation)
                return;

            _items.AddRange(rows.Select(r => r.ToCatalogItem()));
            _loadedVersion = version;
            _total = total;
        }
        catch (AppException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (generation == _generation)
                _loading = false;
        }

        StateHasChanged();
    }

    private async Task FilterAsync(string? type)
    {
        _filter = type;
        _only = CollectionFilter.None;
        _items.Clear();
        await LoadMoreAsync();
    }

    // Sets and minifigs that are new, used, or missing at least one piece
    private async Task ShowOnlyAsync(CollectionFilter only)
    {
        _only = only;
        _items.Clear();
        await LoadMoreAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchDelay?.Cancel();
        _searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchDelay.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _search = e.Value?.ToString();
        _items.Clear();
        await LoadMoreAsync();
    }

    public void Dispose()
    {
        Auth.Changed -= OnChanged;
        Collection.Changed -= OnChanged;
        Profile.Changed -= OnRefresh;
        _leaving?.Dispose();
    }
}
