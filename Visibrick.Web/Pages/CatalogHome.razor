@page "/catalog"
@inject CatalogService Catalog

<PageTitle>Catalog · Visibrick</PageTitle>

<div class="page narrow">
    <div class="page-header">
        <h1>Catalog</h1>
        <p class="muted">Every LEGO minifig, set, part, gear item and book, from BrickLink.</p>
    </div>

    <div class="stack" style="gap: 20px">
        @foreach (var type in CatalogType.All)
        {
            <a class="category clay-card press" href="@CatalogRoutes.List(type)">
                <div class="icon well"><img src="@CatalogRoutes.Icon(type)" alt="" /></div>
                <div>
                    <h2>@type.Name</h2>
                    <p class="caption">@CountText(type)</p>
                </div>
                <span class="chevron" aria-hidden="true">›</span>
            </a>
        }
    </div>

    @if (_error is not null)
    {
        <p class="error center" style="margin-top: 20px">@_error</p>
    }
</div>

@code {
    private Dictionary<string, int>? _counts;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _counts = await Catalog.GetCountsAsync();
        }
        catch (AppException ex)
        {
            _error = ex.Message;
        }
    }

    private string CountText(CatalogType type)
        => _counts is null ? "" : $"{_counts.GetValueOrDefault(type.Code):N0} {type.CountNoun}";
}
