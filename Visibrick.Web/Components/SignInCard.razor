@* "Sign in to start your collection" with email. Google/Apple can go back here once they're turned on in
   Supabase (Authentication → Sign In / Providers); AuthService.StartProviderSignInAsync already handles them. *@

<div class="clay-card stack">
    <img class="brand-mark" src="images/brand_mark.svg" alt="" />
    <div class="stack" style="gap: 4px">
        <h2 class="center">Sign in to start your collection</h2>
        <p class="muted center">Your collection is saved to your account, so it's there on every device.</p>
    </div>

    <div class="stack" style="gap: 12px; margin-top: 8px">
        <a class="btn btn-primary" href="signin">Sign in or create an account</a>
    </div>
</div>
