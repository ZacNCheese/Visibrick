<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Visibrick.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Visibrick"
    Title="Visibrick">

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Minifigs"
            Icon="tab_minifigs.png"
            ContentTemplate="{DataTemplate local:MinifigsPage}"
            Route="MinifigsPage" />
    </TabBar>

</Shell>
