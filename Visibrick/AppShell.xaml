<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Visibrick.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Visibrick.Pages"
    Title="Visibrick">

    <TabBar>
        <ShellContent
            Title="My Collection"
            Icon="tab_collection.png"
            ContentTemplate="{DataTemplate pages:CollectionPage}"
            Route="collection" />

        <!-- Minifigs opens from here; its route is registered in AppShell.xaml.cs -->
        <ShellContent
            Title="Catalog"
            Icon="tab_catalog.png"
            ContentTemplate="{DataTemplate pages:CatalogPage}"
            Route="catalog" />
    </TabBar>

</Shell>
