<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Visibrick.MainPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,32" Spacing="24" MaximumWidthRequest="720">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Visibrick"
                       Style="{StaticResource ClayTitle}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Your LEGO collection, down to the last brick."
                       Style="{StaticResource ClaySubtitle}" />
            </VerticalStackLayout>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Style="{StaticResource ClayCard}">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource ClayShadow}" Offset="0,12" Radius="28" Opacity="0.22" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="MinifigCountLabel" Text="–" Style="{StaticResource ClayStatValue}" />
                        <Label Text="Minifigs" Style="{StaticResource ClayCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ClayCard}">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource ClayShadow}" Offset="0,12" Radius="28" Opacity="0.22" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="ColorCountLabel" Text="–" Style="{StaticResource ClayStatValue}" />
                        <Label Text="Colors" Style="{StaticResource ClayCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Sync -->
            <Border Style="{StaticResource ClayCard}" Padding="24">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ClayShadow}" Offset="0,12" Radius="28" Opacity="0.22" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Rebrickable data" Style="{StaticResource ClayHeading}" />
                        <Label Text="Download the latest colors and minifigs. Rebrickable updates these files daily."
                               Style="{StaticResource ClaySubtitle}" />
                    </VerticalStackLayout>

                    <Button x:Name="SyncBtn"
                            Text="Sync data"
                            Style="{StaticResource ClayButton}"
                            SemanticProperties.Hint="Downloads the latest LEGO data from Rebrickable"
                            Clicked="OnSyncClicked">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,10" Radius="22" Opacity="0.35" />
                        </Button.Shadow>
                    </Button>

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <ActivityIndicator x:Name="SyncSpinner"
                                           IsVisible="False"
                                           HeightRequest="20"
                                           WidthRequest="20" />
                        <Label x:Name="StatusLabel"
                               Style="{StaticResource ClayCaption}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
