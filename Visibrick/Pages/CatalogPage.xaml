<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Visibrick.Controls"
             xmlns:pages="clr-namespace:Visibrick.Pages"
             x:Class="Visibrick.Pages.CatalogPage"
             Shell.NavBarIsVisible="False">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,32" Spacing="20" MaximumWidthRequest="720">

            <!-- Header -->
            <VerticalStackLayout Spacing="2" Margin="0,0,0,4">
                <Label Text="Catalog"
                       Style="{StaticResource ClayTitle}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Every LEGO minifig, set, part, gear item and book, from BrickLink."
                       Style="{StaticResource ClaySubtitle}" />
            </VerticalStackLayout>

            <!-- One card per catalog type (see CatalogPage.xaml.cs for the list) -->
            <VerticalStackLayout x:Name="CategoryList" Spacing="20">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:CatalogCategory">
                        <Border Style="{StaticResource ClayCard}"
                                controls:PressFeedback.IsEnabled="True"
                                Padding="16"
                                SemanticProperties.Description="{Binding Name}"
                                SemanticProperties.Hint="Opens this part of the catalog">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource ClayShadow}" Offset="0,12" Radius="28" Opacity="0.22" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border Style="{StaticResource ClayWell}" WidthRequest="64" HeightRequest="64" Padding="14">
                                    <Image Source="{Binding Icon}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource ClayHeading}" />
                                    <Label Text="{Binding CountText}" Style="{StaticResource ClayCaption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="30" Style="{StaticResource ClaySubtitle}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Catalog status: the catalog updates itself in the background -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,4,0,0">
                <ActivityIndicator x:Name="SyncSpinner"
                                   IsVisible="False"
                                   HeightRequest="16"
                                   WidthRequest="16" />
                <Label x:Name="StatusLabel"
                       Style="{StaticResource ClayCaption}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

    <!-- Account: profile picture in the top-right corner, and the menu it opens (on top of everything) -->
    <controls:ProfileButton Menu="{x:Reference ProfileMenu}" HorizontalOptions="End" Margin="0,24,24,0" />
    <controls:ProfileMenu x:Name="ProfileMenu" />
    </Grid>

</ContentPage>
