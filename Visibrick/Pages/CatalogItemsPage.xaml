<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Visibrick.Core.Models;assembly=Visibrick.Core"
             xmlns:controls="clr-namespace:Visibrick.Controls"
             x:Class="Visibrick.Pages.CatalogItemsPage"
             Shell.NavBarIsVisible="False">

    <!-- One page for every catalog type (minifigs, sets, parts, gear, books); opened with ?type=S etc. -->

    <ContentPage.Resources>
        <!-- One item card. No Borders inside list cards: on Windows they can crash a re-laying-out
             list with "Layout cycle detected", so the card is drawn and rounded shapes are BoxViews. -->
        <DataTemplate x:Key="ItemCard" x:DataType="models:CatalogItem">
            <Grid HeightRequest="274">
                <controls:ClayCardBackground />

                <!-- Margin = the card's shadow room (ClayCardBackground.CardInset) + 12 padding -->
                <VerticalStackLayout Margin="20,22,20,26" Spacing="10">
                    <!-- Image well -->
                    <Grid HeightRequest="140">
                        <BoxView CornerRadius="22"
                                 Color="{AppThemeBinding Light={StaticResource ClayWell}, Dark={StaticResource ClayWellDark}}" />

                        <!-- Shows while the image loads, and stays if BrickLink has no image -->
                        <Image Source="item_placeholder.png"
                               WidthRequest="56"
                               HeightRequest="56"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <Image Source="{Binding ImageUrl}"
                               Aspect="AspectFit"
                               Margin="8"
                               SemanticProperties.Description="{Binding Name}" />
                    </Grid>

                    <Label Text="{Binding Name}"
                           Style="{StaticResource ClayCardTitle}"
                           MaxLines="2"
                           LineBreakMode="TailTruncation"
                           HeightRequest="40" />

                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Number chip: opens the item on BrickLink -->
                        <Grid HorizontalOptions="Start"
                              controls:PressFeedback.IsEnabled="True"
                              ToolTipProperties.Text="Open on BrickLink"
                              SemanticProperties.Description="{Binding Number, StringFormat='{0} on BrickLink'}"
                              SemanticProperties.Hint="Opens this item's page on BrickLink in your browser">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNumberTapped" />
                            </Grid.GestureRecognizers>
                            <BoxView CornerRadius="12"
                                     Color="{AppThemeBinding Light={StaticResource ClayChip}, Dark={StaticResource ClayChipDark}}" />
                            <Label Text="{Binding Number, StringFormat='{0} ↗'}"
                                   Style="{StaticResource ClayChipLabel}"
                                   Margin="10,4" />
                        </Grid>

                        <!-- Release year (empty for parts, which don't have one) -->
                        <Label Grid.Column="1"
                               Text="{Binding YearReleased}"
                               Style="{StaticResource ClayCaption}"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,0">

        <!-- Header -->
        <VerticalStackLayout Padding="8,0" Spacing="2">
            <Button Text="‹ Catalog"
                    Style="{StaticResource ClayLinkButton}"
                    SemanticProperties.Hint="Goes back to the catalog"
                    Clicked="OnBackClicked" />
            <Label x:Name="TitleLabel"
                   Style="{StaticResource ClayTitle}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label x:Name="CountLabel" Style="{StaticResource ClaySubtitle}" />
        </VerticalStackLayout>

        <!-- Search -->
        <Border Grid.Row="1"
                Style="{StaticResource ClayCard}"
                Padding="18,4"
                Margin="8,16,8,8"
                StrokeShape="RoundRectangle 24">
            <Border.Shadow>
                <Shadow Brush="{StaticResource ClayShadow}" Offset="0,12" Radius="28" Opacity="0.22" />
            </Border.Shadow>
            <Entry x:Name="SearchEntry"
                   Style="{StaticResource ClayEntry}"
                   Placeholder="Search by name or number"
                   ClearButtonVisibility="WhileEditing"
                   TextChanged="OnSearchTextChanged" />
        </Border>

        <!-- Item grid: a vertical list of rows of cards (see CardRow for why it isn't a GridItemsLayout).
             More items load when you're within 4 rows of the end. -->
        <CollectionView x:Name="ItemList"
                        Grid.Row="2"
                        ItemsUpdatingScrollMode="KeepScrollOffset"
                        RemainingItemsThreshold="4"
                        RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="controls:CardRow">
                    <controls:UniformRow Columns="{Binding Columns}"
                                         BindableLayout.ItemsSource="{Binding Items}"
                                         BindableLayout.ItemTemplate="{StaticResource ItemCard}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Shown when there's nothing to list -->
        <Border x:Name="EmptyState"
                Grid.Row="2"
                Style="{StaticResource ClayCard}"
                Margin="8,16"
                Padding="28"
                VerticalOptions="Start"
                IsVisible="False">
            <Border.Shadow>
                <Shadow Brush="{StaticResource ClayShadow}" Offset="0,12" Radius="28" Opacity="0.22" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="8">
                <Label x:Name="EmptyTitle" Style="{StaticResource ClayHeading}" HorizontalTextAlignment="Center" />
                <Label x:Name="EmptyMessage" Style="{StaticResource ClaySubtitle}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
