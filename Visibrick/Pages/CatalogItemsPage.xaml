<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Visibrick.Core.Models;assembly=Visibrick.Core"
             xmlns:controls="clr-namespace:Visibrick.Controls"
             xmlns:appmodels="clr-namespace:Visibrick.Models"
             x:Class="Visibrick.Pages.CatalogItemsPage"
             Shell.NavBarIsVisible="False">

    <!-- One page for every catalog type (minifigs, sets, parts, gear, books); opened with ?type=S etc. -->

    <ContentPage.Resources>
        <!-- One item card (see Controls/ItemCardView.xaml) -->
        <DataTemplate x:Key="ItemCard" x:DataType="appmodels:ItemCardModel">
            <controls:ItemCardView />
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,0">

        <!-- Header -->
        <VerticalStackLayout Padding="8,0" Spacing="2">
            <Button Text="‹ Catalog"
                    Style="{StaticResource ClayLinkButton}"
                    SemanticProperties.Hint="Goes back to the catalog"
                    Clicked="OnBackClicked" />
            <Label x:Name="TitleLabel"
                   Style="{StaticResource ClayTitle}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label x:Name="CountLabel" Style="{StaticResource ClaySubtitle}" />
        </VerticalStackLayout>

        <!-- Search -->
        <Border Grid.Row="1"
                Style="{StaticResource ClayCard}"
                Padding="18,4"
                Margin="8,16,8,8"
                StrokeShape="RoundRectangle 24">
            <Border.Shadow>
                <Shadow Brush="{StaticResource ClayShadow}" Offset="0,12" Radius="28" Opacity="0.22" />
            </Border.Shadow>
            <Entry x:Name="SearchEntry"
                   Style="{StaticResource ClayEntry}"
                   Placeholder="Search by name or number"
                   ClearButtonVisibility="WhileEditing"
                   TextChanged="OnSearchTextChanged" />
        </Border>

        <!-- Item grid: a vertical list of rows of cards (see CardRow for why it isn't a GridItemsLayout).
             More items load when you're within 4 rows of the end. -->
        <CollectionView x:Name="ItemList"
                        Grid.Row="2"
                        ItemsUpdatingScrollMode="KeepScrollOffset"
                        RemainingItemsThreshold="4"
                        RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="controls:CardRow">
                    <controls:UniformRow Columns="{Binding Columns}"
                                         BindableLayout.ItemsSource="{Binding Items}"
                                         BindableLayout.ItemTemplate="{StaticResource ItemCard}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Shown when there's nothing to list -->
        <Border x:Name="EmptyState"
                Grid.Row="2"
                Style="{StaticResource ClayCard}"
                Margin="8,16"
                Padding="28"
                VerticalOptions="Start"
                IsVisible="False">
            <Border.Shadow>
                <Shadow Brush="{StaticResource ClayShadow}" Offset="0,12" Radius="28" Opacity="0.22" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="8">
                <Label x:Name="EmptyTitle" Style="{StaticResource ClayHeading}" HorizontalTextAlignment="Center" />
                <Label x:Name="EmptyMessage" Style="{StaticResource ClaySubtitle}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
